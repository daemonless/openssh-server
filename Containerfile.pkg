# --------------------------------------------------------------------------
# THIS FILE IS AUTOGENERATED - DO NOT EDIT MANUALLY
#
# Source: Containerfile.pkg.j2
# --------------------------------------------------------------------------

ARG BASE_VERSION=15.1
FROM ghcr.io/daemonless/base-exec:${BASE_VERSION}

ARG FREEBSD_ARCH=amd64
# openssh-portable or openssh-portable-hpn (the hpn tags).
ARG PKG_NAME="openssh-portable"
# FreeBSD-pam: sudo authenticates through PAM (sshd itself does not use it).
ARG PACKAGES="${PKG_NAME} sudo FreeBSD-pam"

LABEL org.opencontainers.image.title="OpenSSH Server" \
    org.opencontainers.image.description="SSH and SFTP into a container: one user, key or password login, optional sudo." \
    org.opencontainers.image.source="https://github.com/daemonless/openssh-server" \
    org.opencontainers.image.url="https://www.openssh.com/" \
    org.opencontainers.image.licenses="" \
    org.opencontainers.image.vendor="daemonless" \
    org.opencontainers.image.authors="daemonless" \
    io.daemonless.category="Infrastructure" \
    io.daemonless.port="2222" \
    io.daemonless.arch="${FREEBSD_ARCH}" \
    io.daemonless.pkg-source="pkg" \
    io.daemonless.packages="${PACKAGES}" \
    io.daemonless.pkg-name="${PKG_NAME}"

RUN pkg update && \
    pkg install -y ${PACKAGES} && \
    mkdir -p /app && \
    pkg query '%v' ${PKG_NAME} > /app/version && \
    pkg clean -ay && \
    rm -rf /var/cache/pkg/* /var/db/pkg/repos/*

COPY root/ /

RUN chmod +x /healthz /daemonless/init.d/* /daemonless/libexec/sshd

# sshd starts as root (privilege separation) and only lets USER_NAME in.
ENV DAEMONLESS_USER=root
CMD ["/daemonless/libexec/sshd"]

EXPOSE 2222
VOLUME /config